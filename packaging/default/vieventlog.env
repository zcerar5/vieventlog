# ViEventLog Konfiguration
# Nach Änderungen: sudo systemctl restart vieventlog

# Bind-Adresse (IP:PORT)
#BIND_ADDRESS=0.0.0.0:5000

# Basic Authentication (empfohlen für externen Zugriff)
#BASIC_AUTH_USER=admin
#BASIC_AUTH_PASSWORD=ihr-sicheres-passwort

# Einzelner Account (einfache Einrichtung)
# Für mehrere Accounts: /var/lib/vieventlog/accounts.json verwenden
#VICARE_EMAIL=ihre@email.com
#VICARE_PASSWORD=ihr-vicare-passwort
#VICARE_CLIENT_ID=ihre-developer-portal-client-id
#VICARE_ACCOUNT_NAME=Mein Zuhause

# Multi-Account via JSON-Datei (leer lassen für /var/lib/vieventlog/accounts.json)
#VICARE_ACCOUNTS={"accounts":{...}}

# Config-Verzeichnis (Standard: /var/lib/vieventlog)
VICARE_CONFIG_DIR=/var/lib/vieventlog

# Optional: Home Assistant MQTT Discovery fuer SmartClimate Raumwerte
#MQTT_ENABLED=false
#MQTT_BROKER=tcp://homeassistant.local:1883
#MQTT_USERNAME=mqtt-user
#MQTT_PASSWORD=mqtt-passwort
#MQTT_CLIENT_ID=vieventlog
#MQTT_BASE_TOPIC=vieventlog
#MQTT_DISCOVERY_PREFIX=homeassistant
#MQTT_DISCOVERY=true
#MQTT_RETAIN=true
#MQTT_INTERVAL_SECONDS=300
